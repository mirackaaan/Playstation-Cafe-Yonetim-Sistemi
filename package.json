{
  "name": "cave-salon",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@cave/admin-web",
    "dev:server": "node apps/salon-server/dev.mjs",
    "dev:web": "npm run dev --workspace=@cave/public-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:salon": "npm run start --workspace=@cave/salon-server"
  },
  "engines": { "node": ">=22" }
}
